{
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"terminalSequence\":\"\\\\u0007\"}\\n'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/dotfiles/agents/hooks/concise.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/dotfiles/agents/hooks/subagents.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/dotfiles/agents/hooks/git-workflow.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "crit@crit": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "fastModePerSessionOptIn": false,
  "verbose": false,
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
